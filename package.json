{
  "name": "mcp-file-server",
  "version": "1.0.0",
  "description": "Sandboxed MCP file-server connector with git-lite tools and a handoff protocol",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
